# Скопируй в .env и поправь под себя
SECRET_KEY=change-me-to-random-string
DATABASE_URL=postgresql+psycopg2://tracker:tracker@localhost:5432/tracker
# Read-only пользователь для SQL досок (см. README). Необязательно.
# READONLY_DATABASE_URL=postgresql+psycopg2://tracker_ro:ro_password@localhost:5432/tracker

# ---------- Почта (уведомления) ----------
# Если MAIL_SERVER не задан — письма просто не шлются.
MAIL_SERVER=m1.svetets.ru
MAIL_PORT=25
# Шифрования нет
MAIL_USE_TLS=0
MAIL_USERNAME=smtp_login
MAIL_PASSWORD=smtp_password
# Отправитель = логин
MAIL_FROM=smtp_login
MAIL_FROM_NAME=Трекер Мион
# Базовый URL приложения для ссылок в письмах, напр. http://tracker.local
APP_BASE_URL=
